#!/usr/bin/env python3
"""Detect crater-like topographic minima in the Apollo 17 orbital DEM."""

from pathlib import Path
import sys

import matplotlib.pyplot as plt
import numpy as np


# Scripts/03_feature_detector -> LargeScale_Implement
PROJECT_ROOT = Path(__file__).resolve().parents[1]

# This must occur before importing local project modules.
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from features.dilation_detector import detect_craters, detect_peaks


DEM_PATH = PROJECT_ROOT / "DEM" / "orbital_dem_5m.npy"
TRUTH_DEM_PATH = PROJECT_ROOT / "DEM" / "truth_dem_1p5m.npy"
PLOT_DIRECTORY = PROJECT_ROOT / "plots"
PLOT_PATH = PLOT_DIRECTORY / "global_features_preview.png"
FEATURE_PATH = PROJECT_ROOT / "DEM" / "global_craters_n12.npz"
TRUTH_FEATURE_PATH = PROJECT_ROOT / "DEM" / "truth_craters_n40.npz"

TRUTH_DEM_LXY_M = 1.5
N_CELLS_TRUTH = 20

LXY_M = 5.0
N_CELLS = 6
FLATNESS_EPS_M = 0.15


def main() -> None:
    if not DEM_PATH.is_file():
        raise FileNotFoundError(f"DEM not found: {DEM_PATH}")

    dem = np.load(DEM_PATH)
    true_dem = np.load(TRUTH_DEM_PATH)

    if dem.ndim != 2 or true_dem.ndim != 2:
        raise ValueError(f"Expected a 2D DEM, got shape {dem.shape}")

    if not np.isfinite(dem).all() and not np.isfinite(true_dem).all():
        raise ValueError("DEM contains NaN or infinite values")

    detection_distance_m = N_CELLS * LXY_M
    truth_detection_distance_m = N_CELLS_TRUTH * TRUTH_DEM_LXY_M

    craters_rc = detect_peaks(
        dem,
        n=N_CELLS,
        flatness_eps=FLATNESS_EPS_M,
    )

    craters_rc = np.asarray(craters_rc)
    
    true_craters_rc = detect_peaks(
        true_dem,
        n=N_CELLS_TRUTH,
        flatness_eps=FLATNESS_EPS_M,
    )   
    

    if craters_rc.size == 0 and true_craters_rc.size == 0:
        craters_rc = np.empty((0, 2), dtype=int)
        true_craters_rc = np.empty((0, 2), dtype=int)

    if craters_rc.ndim != 2 or craters_rc.shape[1] != 2 or true_craters_rc.ndim != 2 or true_craters_rc.shape[1] != 2:
        raise ValueError(
            "detect_craters must return an array with shape (N, 2), "
            f"but returned {craters_rc.shape}"
        )

    print(
        f"Detected {len(craters_rc)} crater candidates with "
        f"n={N_CELLS} "
        f"(D_detect={detection_distance_m:.2f} m)"
    )

    if len(craters_rc) > 0:
        print("First detected row-column indices:")
        print(craters_rc[:10])

    # Convert raster indices to site-centered map coordinates.
    #
    # Orbital DEM:
    #   edge bounds: [-1000, 1000] m
    #   first cell center: x=-997.5 m, y=+997.5 m
    #   columns increase eastward
    #   rows increase southward
    rows = craters_rc[:, 0].astype(int)
    columns = craters_rc[:, 1].astype(int)

    x_m = -997.5 + columns * LXY_M
    y_m = 997.5 - rows * LXY_M
    z_m = dem[rows, columns]
    
    x_m_truth = -997.5 + true_craters_rc[:, 1].astype(int) * TRUTH_DEM_LXY_M
    y_m_truth = 997.5 - true_craters_rc[:, 0].astype(int) * TRUTH_DEM_LXY_M
    z_m_truth = true_dem[true_craters_rc[:, 0].astype(int), true_craters_rc[:, 1].astype(int)]

    PLOT_DIRECTORY.mkdir(parents=True, exist_ok=True)

    np.savez(
        FEATURE_PATH,
        row=rows,
        column=columns,
        x_m=x_m,
        y_m=y_m,
        z_m=z_m,
        detection_radius_cells=N_CELLS,
        detection_distance_m=detection_distance_m,
        flatness_eps_m=FLATNESS_EPS_M,
        resolution_m=LXY_M,
    )
    
    np.savez(
        TRUTH_FEATURE_PATH,
        row=true_craters_rc[:, 0].astype(int),
        column=true_craters_rc[:, 1].astype(int),
        x_m=x_m_truth,
        y_m=y_m_truth,
        z_m=z_m_truth,
        detection_radius_cells=N_CELLS_TRUTH,
        detection_distance_m=truth_detection_distance_m,
        flatness_eps_m=FLATNESS_EPS_M,
        resolution_m=TRUTH_DEM_LXY_M,
    )

    figure, axis = plt.subplots(figsize=(9, 8))   
    

    image = axis.imshow(
        dem,
        cmap="terrain",
        origin="upper",
        extent=(-1000.0, 1000.0, -1000.0, 1000.0),
    )

    if len(craters_rc) > 0:
        axis.scatter(
            x_m,
            y_m,
            marker="x",
            s=30,
            label="Detected crater candidates",
        )

    axis.set_title(
        "Apollo 17 orbital DEM features\n"
        f"n={N_CELLS}, "
        f"D_detect={detection_distance_m:.0f} m, "
        f"N={len(craters_rc)}"
    )
    axis.set_xlabel("Map x / east [m]")
    axis.set_ylabel("Map y / north [m]")
    axis.set_aspect("equal")
    axis.legend()

    figure.colorbar(image, ax=axis, label="Elevation [m]")
    figure.tight_layout()
    figure.savefig(PLOT_PATH, dpi=200)
    plt.close(figure)
    
    figure_truth, axis_truth = plt.subplots(figsize=(9, 8))
    image_truth = axis_truth.imshow(
        true_dem,
        cmap="terrain",
        origin="upper",
        extent=(-1000.0, 1000.0, -1000.0, 1000.0),
    )
    if len(true_craters_rc) > 0:
        axis_truth.scatter(
            x_m_truth,
            y_m_truth,
            marker="x",
            s=30,
            label="Detected truth crater candidates",
        )
        
    axis_truth.set_title(
        "Apollo 17 truth DEM features\n"
        f"n={N_CELLS_TRUTH}, "
        f"D_detect={truth_detection_distance_m:.0f} m, "
        f"N={len(true_craters_rc)}"
    )
    axis_truth.set_xlabel("Map x / east [m]")
    axis_truth.set_ylabel("Map y / north [m]")
    axis_truth.set_aspect("equal")
    axis_truth.legend()
    figure_truth.colorbar(image_truth, ax=axis_truth, label="Elevation [m]")
    figure_truth.tight_layout()
    figure_truth.savefig(PLOT_DIRECTORY / "truth_features_preview.png", dpi=200)    

    print(f"Saved feature catalogue: {FEATURE_PATH}")
    print(f"Saved preview plot:      {PLOT_PATH}")
    print(f"Saved truth catalogue:   {TRUTH_FEATURE_PATH}")


if __name__ == "__main__":
    main()