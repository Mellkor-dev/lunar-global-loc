import numpy as np
import sys, os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

from refinement.moga import run_moga
from sim.traverse_recorder import build_traverse
from refinement.moga import wrap_angle

results = np.load("maps/data/traverse_darces_results.npy", allow_pickle=True).item()
traverse = build_traverse()  # rebuilds world_t, world_R, odometry_chain (3D)

site_names = traverse["sites"]

# --- Initial poses from DARCES (x, y, heading_from_R) ---
initial_poses = {}
for s in site_names:
    r = results[s]
    if r is None:
        print(f"WARNING: {s} Not computed DARCES yet")
        continue
    t = r["darces_t"]
    R = r["darces_R"]
    theta = np.arctan2(R[1, 0], R[0, 0])
    initial_poses[s] = (t[0], t[1], theta)

# --- Feature correspondences from DARCES's matched triplets ---
feature_correspondences = {}
for s in site_names:
    r = results[s]
    if r is None:
        continue
    feature_correspondences[s] = r["matched_pairs"]

# --- Reduce 3D odometry chain to 2D (xy translation, yaw-only rotation) ---
odometry_chain_2d = []
for edge in traverse["odometry_chain"]:
    R3 = edge["R"]
    rho3 = edge["rho"]
    dtheta = np.arctan2(R3[1, 0], R3[0, 0])
    odometry_chain_2d.append({
        "from": edge["from"], "to": edge["to"],
        "rho_xy": rho3[:2], "dtheta": dtheta
    })

# --- Absolute orientation measurements: true yaw per site (independent
#     of DARCES's own heading estimate — saved during script 13's run) ---
orientation_measurements = {}
for s in site_names:
    r = results[s]
    if r is None or "true_yaw_deg" not in r:
        continue
    orientation_measurements[s] = np.radians(r["true_yaw_deg"])

print("=== DARCES initial estimates ===")
for s in site_names:
    if s not in initial_poses:
        continue
    x, y, th = initial_poses[s]
    gt = results[s]["ground_truth_xy"]
    err = np.linalg.norm(np.array([x, y]) - gt)
    print(f"{s}: x={x:.2f} y={y:.2f} heading={np.degrees(wrap_angle(th)):.1f}deg  "
          f"(pos_err={err:.2f}m)")

refined = run_moga(
    [s for s in site_names if s in initial_poses],
    initial_poses, feature_correspondences, odometry_chain_2d,
    orientation_measurements=orientation_measurements,
    sigma_feature=0.4, sigma_odom_trans=0.3, sigma_odom_rot_deg=2.0,
    sigma_heading_deg=1.0,
    max_iter=100, e_converge=1e-8, verbose=True
)

print("\n=== MOGA refined vs ground truth ===")
for s in site_names:
    if s not in refined:
        continue
    x, y, th = refined[s]
    gt = results[s]["ground_truth_xy"]
    darces_err = results[s]["error_m"]
    moga_err = np.linalg.norm(np.array([x, y]) - gt)
    print(f"{s}: MOGA x={x:.2f} y={y:.2f} heading={np.degrees(th):.1f}deg  "
          f"| DARCES_err={darces_err:.2f}m -> MOGA_err={moga_err:.2f}m  "
          f"({'IMPROVED' if moga_err < darces_err else 'worse'})")